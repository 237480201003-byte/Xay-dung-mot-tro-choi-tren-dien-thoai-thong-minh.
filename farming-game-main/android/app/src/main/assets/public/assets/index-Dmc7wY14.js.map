export default "{\n  \"name\": \"sprout-hollow\",\n  \"version\": \"1.4.3\",\n  \"description\": \"A cozy pixel-art farming game for the desktop. Clear the valley, work the soil, survive four seasons.\",\n  \"license\": \"MIT\",\n  \"author\": \"DingDingChae\",\n  \"main\": \"dist-electron/main.js\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"start\": \"npm run build:main && vite build && electron .\",\n    \"build:main\": \"tsc -p tsconfig.main.json\",\n    \"build:renderer\": \"vite build\",\n    \"build:site\": \"vite build --config vite.site.config.ts\",\n    \"build\": \"npm run typecheck && npm run build:main && npm run build:renderer\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"package\": \"npm run icon && npm run build && electron-builder --win squirrel --publish never\",\n    \"shots\": \"node scripts/render-shots.mjs\",\n    \"count\": \"node scripts/count-lines.mjs\",\n    \"check:build\": \"node scripts/check-build-config.mjs\",\n    \"dish\": \"node scripts/dish-name.mjs\",\n    \"icon\": \"node scripts/make-icon.mjs\",\n    \"check:icon\": \"node scripts/check-icon.mjs\",\n    \"check:exports\": \"node scripts/dead-exports.mjs\",\n    \"smoke\": \"node scripts/smoke-launch.mjs\",\n    \"android:sync\": \"cap sync android\",\n    \"android:open\": \"cap open android\",\n    \"android:run\": \"cap run android\",\n    \"android:build\": \"npm run build:renderer && cap sync android && cd android && ./gradlew assembleDebug\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.9.0\",\n    \"electron\": \"^43.4.0\",\n    \"electron-builder\": \"^26.15.3\",\n    \"electron-builder-squirrel-windows\": \"^26.15.3\",\n    \"typescript\": \"^5.6.3\",\n    \"vite\": \"^5.4.10\",\n    \"vitest\": \"^2.1.4\"\n  },\n  \"build\": {\n    \"appId\": \"uk.dewhui.sprouthollow\",\n    \"productName\": \"Sprout Hollow\",\n    \"directories\": {\n      \"output\": \"release\"\n    },\n    \"files\": [\n      \"dist/**/*\",\n      \"dist-electron/**/*\",\n      \"package.json\"\n    ],\n    \"win\": {\n      \"target\": [\n        \"squirrel\"\n      ],\n      \"signAndEditExecutable\": true,\n      \"signExecutable\": false,\n      \"verifyUpdateCodeSignature\": false,\n      \"icon\": \"build/icon.ico\"\n    },\n    \"squirrelWindows\": {\n      \"artifactName\": \"${productName}-Setup-${version}.${ext}\",\n      \"msi\": false\n    },\n    \"forceCodeSigning\": false\n  }\n}\n"